# Get these from https://developer.spotify.com/dashboard
# Create an app there, then copy the Client ID and Client Secret below.
# Used server-side for: track search + playlist import (Client Credentials flow)
# AND the user login that powers in-page playback (Authorization Code flow).
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Base URL of this app. Used to build shareable links AND the Spotify OAuth
# redirect URI (`${NEXT_PUBLIC_BASE_URL}/api/spotify/auth/callback`).
#
# For local dev use the loopback IP, NOT localhost — Spotify rejects
# http://localhost as a redirect URI. Open the app at http://127.0.0.1:3000.
# In production, set this to your https domain.
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Playback setup (Spotify Web Playback SDK):
#  1. In the Spotify dashboard → your app → Settings → Redirect URIs, add:
#       http://127.0.0.1:3000/api/spotify/auth/callback   (local dev)
#       https://<your-domain>/api/spotify/auth/callback    (production)
#  2. Each listener must log in with a Spotify PREMIUM account to hear audio.
#     (Free accounts / not-logged-in visitors see a silent visual player.)
