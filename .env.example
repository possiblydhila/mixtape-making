# Get these from https://developer.spotify.com/dashboard
# Create an app there, then copy the Client ID and Client Secret below.
# Used server-side only (Client Credentials flow) for track search and playlist import.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Base URL of this app, used to build shareable mixtape links.
# For local dev, leave as is. In production, set to your deployed domain.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
